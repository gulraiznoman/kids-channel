   "text": "March your legs! Left, right, left, right!",
   "t": 118.121,
   "dur": 2.089
  },
  {
   "who": "mishu",
   "text": "These are my fingers!",
   "t": 123.41,
   "dur": 1.159
  },
  {
   "who": "gul",
   "text": "Wiggle your fingers! Wiggle, wiggle!",
   "t": 124.968,
   "dur": 1.82
  },
  {
   "who": "gul",
   "text": "Big kids! Our body has five senses!",
   "t": 130.088,
   "dur": 2.194
  },
  {
   "who": "mishu",
   "text": "Sense number 1: see!",
   "t": 133.482,
   "dur": 1.315
  },
  {
   "who": "gul",
   "text": "I can see a rainbow! What colours do you see?",
   "t": 135.197,
   "dur": 2.361
  },
  {
   "who": "mishu",
   "text": "We see with our eyes!",
   "t": 138.058,
   "dur": 1.127
  },
  {
   "who": "mishu",
   "text": "Sense number 2: hear!",
   "t": 140.185,
   "dur": 1.461
  },
  {
   "who": "gul",
   "text": "Ding, ding! Boom, boom! I hear a bell and a drum!",
   "t": 142.046,
   "dur": 2.485
  },
  {
   "who": "mishu",
   "text": "We hear with our ears!",
   "t": 145.031,
   "dur": 1.225
  },
  {
   "who": "mishu",
   "text": "Sense number 3: smell!",
   "t": 147.257,
   "dur": 1.668
  },
  {
   "who": "gul",
   "text": "Sniff, sniff! The flower smells so nice!",
   "t": 149.325,
   "dur": 2.225
  },
  {
   "who": "mishu",
   "text": "We smell with our nose!",
   "t": 152.05,
   "dur": 1.245
  },
  {
   "who": "mishu",
   "text": "Sense number 4: taste!",
   "t": 154.295,
   "dur": 1.692
  },
  {
   "who": "gul",
   "text": "The lemon is sour! Ewww! The ice cream is sweet! Yum!",
   "t": 156.387,
   "dur": 2.732
  },
  {
   "who": "mishu",
   "text": "We taste with our tongue!",
   "t": 159.619,
   "dur": 1.233
  },
  {
   "who": "mishu",
   "text": "Sense number 5: touch!",
   "t": 161.851,
   "dur": 1.655
  },
  {
   "who": "gul",
   "text": "The teddy is soft! The cactus is spiky! Ouch!",
