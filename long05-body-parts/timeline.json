{
 "lines": [
  {
   "who": "gul",
   "text": "Oh no! Where is my nose?!",
   "t": 0.4,
   "dur": 1.358
  },
  {
   "who": "mishu",
   "text": "Gul! Your nose is gone! Let's find it!",
   "t": 2.258,
   "dur": 2.186
  },
  {
   "who": "mishu",
   "text": "Found it! It was in the toy box!",
   "t": 6.144,
   "dur": 1.628
  },
  {
   "who": "gul",
   "text": "Phew! Thank you, Mishu! Boop!",
   "t": 8.872,
   "dur": 1.405
  },
  {
   "who": "mishu",
   "text": "Let's learn all about our body!",
   "t": 10.777,
   "dur": 1.599
  },
  {
   "who": "gul",
   "text": "First, let's look at my face!",
   "t": 13.576,
   "dur": 1.513
