  },
  {
   "who": "mishu",
   "text": "Say it! Friday!",
   "t": 91.819,
   "dur": 1.01
  },
  {
   "who": "both",
   "text": "It's Saturday!",
   "t": 94.379,
   "dur": 0.859
  },
  {
   "who": "gul",
   "text": "On Saturday, we play at the park! Wheee!",
   "t": 95.538,
   "dur": 2.001
  },
  {
   "who": "mishu",
   "text": "Swings, slides, and a big red ball!",
