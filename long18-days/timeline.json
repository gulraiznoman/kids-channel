  },
  {
   "who": "gul",
   "text": "Say it! Saturday!",
   "t": 100.24,
   "dur": 1.019
  },
  {
   "who": "both",
   "text": "It's Sunday!",
   "t": 102.809,
   "dur": 0.794
  },
  {
   "who": "mishu",
   "text": "On Sunday, we visit Grandma! Hello, Grandma!",
