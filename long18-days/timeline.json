  {
   "who": "gul",
   "text": "What do Gul and Mishu do every day? Let's see!",
   "t": 48.259,
   "dur": 2.472
  },
  {
   "who": "both",
   "text": "It's Monday!",
   "t": 51.181,
   "dur": 0.844
  },
  {
   "who": "mishu",
   "text": "On Monday, we go to school! Hello, teacher!",
   "t": 52.325,
   "dur": 2.525
  },
  {
   "who": "gul",
   "text": "We learn letters and numbers!",
   "t": 55.151,
   "dur": 1.56
  },
  {
   "who": "mishu",
   "text": "Say it! Monday!",
   "t": 56.96,
   "dur": 1.054
  },
  {
   "who": "both",
   "text": "It's Tuesday!",
   "t": 59.565,
   "dur": 0.926
  },
  {
   "who": "gul",
   "text": "On Tuesday, we go swimming! Splash, splash!",
   "t": 60.79,
   "dur": 2.487
  },
  {
   "who": "mishu",
   "text": "Kick your legs! Swim like a fish!",
   "t": 63.578,
   "dur": 1.788
  },
  {
   "who": "gul",
   "text": "Say it! Tuesday!",
   "t": 65.616,
   "dur": 1.068
  },
  {
   "who": "both",
   "text": "It's Wednesday!",
   "t": 68.234,
   "dur": 0.917
  },
  {
   "who": "mishu",
   "text": "On Wednesday, we read books at the library! Shh!",
   "t": 69.451,
   "dur": 3.325
  },
  {
   "who": "gul",
   "text": "So many stories to read!",
   "t": 73.076,
   "dur": 1.366
  },
  {
   "who": "mishu",
   "text": "Say it! Wednesday!",
   "t": 74.692,
   "dur": 1.083
  },
  {
   "who": "both",
   "text": "It's Thursday!",
   "t": 77.325,
   "dur": 0.911
  },
  {
   "who": "gul",
   "text": "On Thursday, we help in the garden!",
   "t": 78.536,
   "dur": 1.859
  },
  {
   "who": "mishu",
   "text": "Water the plants, so they grow big and tall!",
   "t": 80.695,
   "dur": 2.278
  },
  {
   "who": "gul",
   "text": "Say it! Thursday!",
   "t": 83.223,
   "dur": 1.073
  },
  {
   "who": "both",
   "text": "It's Friday!",
   "t": 85.846,
   "dur": 0.859
  },
  {
   "who": "mishu",
   "text": "On Friday, we have a pizza party! Yummy!",
   "t": 87.006,
   "dur": 2.53
  },
  {
   "who": "gul",
   "text": "Pizza with cheese and tomatoes!",
   "t": 89.836,
