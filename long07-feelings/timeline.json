   "dur": 2.068
  },
  {
   "who": "gul",
   "text": "Tell a grown-up how you feel. Talking helps!",
   "t": 372.856,
   "dur": 2.301
  },
  {
   "who": "mishu",
   "text": "Take a little rest in a quiet, cozy corner.",
   "t": 375.907,
   "dur": 2.331
  },
  {
   "who": "gul",
   "text": "Have a drink of cool water.",
   "t": 378.988,
   "dur": 1.351
  },
  {
   "who": "gul",
   "text": "Now let's dance our feelings! Copy us!",
   "t": 381.589,
   "dur": 2.139
  },
  {
