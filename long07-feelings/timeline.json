  },
  {
   "who": "mishu",
   "text": "How can we help?",
   "t": 429.488,
   "dur": 0.98
  },
  {
   "who": "gul",
   "text": "Are you okay, Mishu? Here's a big hug!",
   "t": 432.918,
   "dur": 2.084
  },
  {
   "who": "mishu",
   "text": "Thank you! I feel happy now!",
   "t": 435.352,
   "dur": 1.616
  },
  {
   "who": "mishu",
   "text": "Gul has no toy to play with. He feels sad.",
   "t": 437.618,
   "dur": 2.463
  },
  {
   "who": "gul",
   "text": "How can we help?",
   "t": 440.331,
   "dur": 0.916
  },
  {
   "who": "mishu",
   "text": "Gul, let's share my teddy! We can play together!",
