   "text": "Write a big A in the air!",
   "t": 446.013,
   "dur": 1.302
  },
  {
   "who": "both",
   "text": "Draw a circle! Round and round!",
   "t": 449.065,
   "dur": 1.875
  },
  {
   "who": "both",
   "text": "Zig zag, zig zag!",
   "t": 452.69,
