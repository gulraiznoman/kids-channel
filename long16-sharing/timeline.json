{
 "lines": [
  {
   "who": "gul",
   "text": "Mine!",
   "t": 0.0,
   "dur": 0.531
  },
  {
   "who": "mishu",
   "text": "No, mine!",
   "t": 0.681,
   "dur": 0.718
  },
  {
   "who": "both",
   "text": "Sharing is caring!",
   "t": 1.649,
   "dur": 1.048
  },
  {
   "who": "mishu",
   "text": "Let's learn how to share, take turns, and be kind!",
   "t": 3.048,
   "dur": 2.649
  },
  {
   "who": "gul",
   "text": "Let's go!",
   "t": 6.047,
   "dur": 0.711
  },
  {
   "who": "gul",
   "text": "What does sharing mean?",
   "t": 7.808,
   "dur": 1.154
  },
  {
   "who": "mishu",
   "text": "Sharing means letting a friend use or have some of what you have.",
   "t": 9.412,
   "dur": 3.322
  },
  {
   "who": "gul",
   "text": "When we share, our friends feel happy.",
   "t": 13.085,
   "dur": 1.828
  },
  {
   "who": "mishu",
   "text": "And we feel happy too! Our hearts grow big!",
   "t": 15.263,
   "dur": 2.44
  },
  {
   "who": "mishu",
   "text": "Let's watch Gul and Mishu learn to share!",
   "t": 18.853,
   "dur": 2.002
  },
  {
   "who": "gul",
   "text": "Gul has one big cookie.",
   "t": 21.304,
   "dur": 1.412
  },
  {
   "who": "mishu",
   "text": "Mishu has no cookie. She feels sad.",
   "t": 23.067,
   "dur": 2.282
  },
  {
   "who": "gul",
   "text": "What can we do?",
   "t": 25.599,
   "dur": 0.924
  },
  {
   "who": "mishu",
   "text": "Gul breaks the cookie in half. One for you, one for me!",
   "t": 28.572,
   "dur": 2.912
  },
  {
   "who": "both",
   "text": "Yummy! Sharing is caring!",
   "t": 31.834,
   "dur": 1.473
  },
  {
   "who": "mishu",
   "text": "Mishu is drawing with all the crayons.",
   "t": 33.957,
   "dur": 1.959
  },
  {
   "who": "gul",
   "text": "Gul wants to draw too.",
   "t": 36.265,
   "dur": 1.297
  },
  {
   "who": "mishu",
   "text": "What can we do?",
   "t": 37.813,
   "dur": 0.826
  },
  {
   "who": "gul",
   "text": "Mishu shares her crayons. You take blue, I take red!",
   "t": 40.688,
   "dur": 2.96
  },
  {
   "who": "both",
   "text": "Now we can draw together!",
   "t": 43.999,
   "dur": 1.394
  },
  {
   "who": "gul",
   "text": "There is only one swing.",
   "t": 46.042,
   "dur": 1.222
  },
  {
   "who": "mishu",
   "text": "Gul and Mishu both want to swing!",
   "t": 47.615,
   "dur": 1.706
  },
  {
   "who": "gul",
   "text": "What can we do?",
   "t": 49.571,
   "dur": 0.924
  },
  {
   "who": "mishu",
   "text": "Let's take turns! Ten swings each. One, two, three...",
   "t": 52.545,
   "dur": 3.205
  },
  {
   "who": "both",
   "text": "Taking turns is fair!",
   "t": 56.1,
   "dur": 1.257
  },
  {
   "who": "mishu",
   "text": "Oh no! It's raining!",
   "t": 58.007,
   "dur": 1.166
  },
  {
   "who": "gul",
   "text": "Mishu forgot her umbrella.",
   "t": 59.523,
   "dur": 1.531
  },
  {
   "who": "mishu",
   "text": "What can we do?",
   "t": 61.304,
   "dur": 0.826
  },
  {
   "who": "gul",
   "text": "Gul shares his umbrella. Come under, Mishu!",
