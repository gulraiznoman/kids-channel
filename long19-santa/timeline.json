{
 "lines": [
  {
   "who": "both",
   "text": "It's Christmas Eve!",
   "t": 1.9,
   "dur": 1.043
  },
  {
   "who": "mishu",
   "text": "Tonight, Santa Claus is coming!",
   "t": 3.293,
   "dur": 1.742
  },
  {
   "who": "gul",
   "text": "Let's find out all about Santa! Let's go!",
   "t": 5.385,
   "dur": 2.208
  },
  {
   "who": "gul",
   "text": "This is Santa Claus! He lives at the North Pole!",
   "t": 8.642,
   "dur": 2.503
  },
  {
   "who": "mishu",
   "text": "Santa is kind, and jolly, and he loves to laugh! Ho, ho, ho!",
   "t": 12.896,
   "dur": 3.747
  },
  {
   "who": "gul",
   "text": "A red hat with a white fluffy pom-pom!",
   "t": 17.292,
   "dur": 2.043
  },
  {
   "who": "mishu",
   "text": "A long, white, fluffy beard!",
   "t": 19.886,
   "dur": 1.564
  },
  {
   "who": "gul",
   "text": "A big red coat!",
   "t": 22.0,
   "dur": 1.051
  },
  {
   "who": "mishu",
   "text": "A black belt with a shiny gold buckle!",
   "t": 23.601,
   "dur": 1.967
  },
  {
   "who": "gul",
   "text": "And big black boots! Stomp, stomp!",
   "t": 26.118,
   "dur": 1.959
  },
  {
   "who": "mishu",
   "text": "Santa is so colourful! What colour is it?",
   "t": 29.127,
   "dur": 2.429
  },
  {
   "who": "gul",
   "text": "What colour is it?",
   "t": 32.006,
   "dur": 0.991
  },
  {
   "who": "mishu",
   "text": "Santa's coat is red!",
   "t": 34.847,
   "dur": 1.282
  },
  {
   "who": "mishu",
   "text": "What colour is it?",
   "t": 36.678,
   "dur": 1.04
  },
  {
   "who": "gul",
   "text": "Santa's beard is white!",
   "t": 39.568,
   "dur": 1.318
  },
  {
   "who": "gul",
   "text": "What colour is it?",
   "t": 41.436,
   "dur": 0.991
  },
  {
   "who": "mishu",
   "text": "Santa's boots are black!",
   "t": 44.277,
   "dur": 1.303
  },
  {
   "who": "mishu",
   "text": "What colour is it?",
   "t": 46.129,
   "dur": 1.04
  },
  {
   "who": "gul",
   "text": "Santa's buckle is gold!",
   "t": 49.019,
   "dur": 1.428
  },
  {
   "who": "gul",
   "text": "What colour is it?",
   "t": 50.997,
   "dur": 0.991
  },
  {
   "who": "mishu",
   "text": "The reindeer are brown!",
   "t": 53.838,
   "dur": 1.197
  },
  {
   "who": "mishu",
   "text": "Let's write a letter to Santa!",
   "t": 56.085,
   "dur": 1.558
  },
  {
   "who": "mishu",
   "text": "Dear Santa,",
   "t": 58.093,
   "dur": 0.811
  },
  {
   "who": "mishu",
   "text": "This year, I shared my toys, and I helped my mama.",
   "t": 59.454,
   "dur": 2.935
  },
  {
   "who": "mishu",
   "text": "For Christmas, may I please have a teddy bear?",
   "t": 62.939,
   "dur": 2.328
  },
  {
   "who": "mishu",
   "text": "Thank you, Santa! Love, Mishu.",
   "t": 65.817,
   "dur": 1.909
  },
  {
   "who": "gul",
   "text": "Now, post it to the North Pole! Whoosh!",
   "t": 68.276,
   "dur": 2.033
  },
  {
   "who": "gul",
   "text": "The North Pole is very cold! What do we wear?",
   "t": 71.359,
   "dur": 2.498
  },
  {
   "who": "mishu",
   "text": "A warm hat!",
   "t": 74.307,
   "dur": 0.844
  },
  {
   "who": "gul",
   "text": "A cosy scarf!",
   "t": 75.601,
   "dur": 1.022
  },
  {
   "who": "mishu",
   "text": "Warm mittens!",
   "t": 77.073,
   "dur": 0.821
  },
  {
   "who": "gul",
   "text": "And snow boots! Now we're ready for the North Pole!",
   "t": 78.344,
   "dur": 2.533
  },
  {
   "who": "gul",
   "text": "At the North Pole, Santa's helpers make toys all year!",
   "t": 82.127,
   "dur": 2.9
  },
  {
   "who": "mishu",
   "text": "A teddy bear!",
   "t": 85.477,
   "dur": 0.802
  },
  {
   "who": "gul",
   "text": "A toy car!",
   "t": 86.628,
   "dur": 0.842
  },
  {
   "who": "mishu",
   "text": "A bouncy ball!",
   "t": 87.82,
   "dur": 0.918
  },
  {
   "who": "gul",
   "text": "A toy train!",
   "t": 89.088,
   "dur": 0.94
  },
  {
   "who": "mishu",
   "text": "Crayons!",
   "t": 90.378,
   "dur": 0.708
  },
  {
   "who": "gul",
   "text": "Building blocks!",
   "t": 91.436,
   "dur": 0.947
  },
  {
   "who": "both",
   "text": "Six toys! Tap, tap, all done!",
   "t": 92.733,
   "dur": 2.042
  },
  {
   "who": "mishu",
   "text": "Let's load the presents onto the sleigh! Count with us!",
   "t": 95.924,
   "dur": 2.87
  },
  {
   "who": "both",
   "text": "One!",
   "t": 99.244,
   "dur": 0.486
  },
  {
   "who": "both",
   "text": "Two!",
   "t": 100.0,
   "dur": 0.464
  },
  {
   "who": "both",
   "text": "Three!",
   "t": 100.734,
   "dur": 0.543
  },
  {
   "who": "both",
   "text": "Four!",
   "t": 101.547,
   "dur": 0.535
  },
  {
   "who": "both",
   "text": "Five!",
   "t": 102.352,
   "dur": 0.574
  },
  {
   "who": "both",
   "text": "Six!",
   "t": 103.197,
   "dur": 0.581
  },
  {
   "who": "both",
   "text": "Seven!",
   "t": 104.048,
   "dur": 0.613
  },
  {
   "who": "both",
   "text": "Eight!",
   "t": 104.931,
   "dur": 0.508
  },
  {
   "who": "both",
   "text": "Nine!",
   "t": 105.709,
   "dur": 0.54
  },
  {
   "who": "both",
   "text": "Ten!",
   "t": 106.519,
   "dur": 0.503
  },
  {
   "who": "gul",
   "text": "Ten presents! The sleigh is full!",
   "t": 107.292,
   "dur": 1.738
  },
  {
   "who": "gul",
   "text": "Santa's sleigh is pulled by eight reindeer! Let's meet them!",
   "t": 110.18,
   "dur": 3.156
  },
  {
   "who": "mishu",
   "text": "One, Dasher!",
   "t": 113.786,
   "dur": 0.844
  },
  {
   "who": "gul",
   "text": "Two, Dancer!",
   "t": 114.929,
   "dur": 0.85
  },
  {
   "who": "mishu",
   "text": "Three, Prancer!",
   "t": 116.08,
   "dur": 0.962
  },
  {
   "who": "gul",
   "text": "Four, Vixen!",
   "t": 117.342,
   "dur": 0.867
  },
  {
   "who": "mishu",
   "text": "Five, Comet!",
   "t": 118.509,
   "dur": 0.888
  },
  {
   "who": "gul",
   "text": "Six, Cupid!",
   "t": 119.698,
   "dur": 0.903
  },
  {
   "who": "mishu",
   "text": "Seven, Donder!",
   "t": 120.9,
   "dur": 0.955
  },
  {
   "who": "gul",
   "text": "Eight, Blitzen!",
   "t": 122.155,
   "dur": 0.875
  },
  {
   "who": "both",
   "text": "Eight reindeer! Ready to fly!",
   "t": 123.33,
   "dur": 1.651
  },
  {
   "who": "gul",
   "text": "Reindeer have big antlers, like tree branches!",
   "t": 125.631,
   "dur": 2.413
  },
  {
   "who": "mishu",
   "text": "Reindeer live where it's very cold and snowy!",
   "t": 128.694,
   "dur": 2.226
  },
  {
   "who": "gul",
   "text": "Reindeer love to eat carrots! Crunch, crunch!",
   "t": 131.57,
   "dur": 2.443
  },
  {
   "who": "mishu",
   "text": "Santa's sleigh flies all around the world!",
   "t": 135.164,
   "dur": 2.195
  },
  {
   "who": "both",
   "text": "Up, up, and away!",
   "t": 137.809,
   "dur": 1.064
  },
  {
   "who": "gul",
   "text": "House one!",
   "t": 139.223,
   "dur": 0.721
  },
  {
   "who": "mishu",
   "text": "House two!",
   "t": 140.294,
   "dur": 0.743
  },
  {
   "who": "gul",
   "text": "House three!",
   "t": 141.387,
   "dur": 0.799
  },
  {
   "who": "mishu",
   "text": "House four!",
   "t": 142.536,
   "dur": 0.762
  },
  {
   "who": "gul",
   "text": "House five!",
   "t": 143.648,
   "dur": 0.811
  },
  {
   "who": "both",
   "text": "Santa visits every house, all in one night!",
   "t": 144.809,
   "dur": 2.58
  },
  {
   "who": "gul",
   "text": "How does Santa get inside? Let's see!",
   "t": 148.539,
   "dur": 2.051
  },
  {
   "who": "mishu",
   "text": "Santa lands on the roof. Tap, tap, tap!",
   "t": 151.04,
   "dur": 2.672
  },
  {
   "who": "gul",
   "text": "He climbs down the chimney. Whoosh!",
   "t": 154.262,
   "dur": 2.027
  },
  {
   "who": "mishu",
   "text": "He puts presents under the tree, very quietly. Shh!",
   "t": 156.839,
   "dur": 3.513
  },
  {
   "who": "gul",
   "text": "Then back up the chimney, and away he goes!",
   "t": 160.903,
   "dur": 2.191
  },
  {
   "who": "mishu",
   "text": "Santa gets hungry! Let's leave him a snack!",
   "t": 164.143,
   "dur": 2.44
  },
  {
   "who": "gul",
   "text": "Let's leave cookies for Santa!",
   "t": 167.034,
   "dur": 1.588
  },
  {
   "who": "mishu",
   "text": "And a glass of milk!",
   "t": 169.072,
   "dur": 1.114
  },
  {
   "who": "gul",
   "text": "And carrots for the reindeer!",
   "t": 170.635,
   "dur": 1.391
  },
  {
   "who": "both",
   "text": "Three cookies, one milk, two carrots! Thank you, Santa!",
   "t": 172.477,
   "dur": 3.017
  },
  {
   "who": "gul",
   "text": "It's getting late! Time to get ready for bed!",
   "t": 176.644,
   "dur": 2.258
  },
  {
   "who": "mishu",
   "text": "Put on your pyjamas!",
   "t": 179.353,
   "dur": 1.106
  },
  {
   "who": "gul",
   "text": "Hang up your stocking!",
   "t": 181.109,
   "dur": 1.099
  },
  {
   "who": "mishu",
   "text": "Brush your teeth!",
   "t": 182.858,
   "dur": 0.948
  },
  {
   "who": "gul",
   "text": "Then off to bed! Santa only comes when you're fast asleep. Shh!",
   "t": 184.456,
   "dur": 3.709
  },
  {
   "who": "gul",
   "text": "Shh! Santa is here! Ho, ho, ho!",
   "t": 190.615,
   "dur": 2.167
  },
  {
   "who": "mishu",
   "text": "Merry Christmas to all, and to all a good night!",
   "t": 193.232,
   "dur": 2.547
  },
  {
   "who": "mishu",
   "text": "Let's count down to Christmas morning!",
   "t": 196.529,
   "dur": 1.867
  },
  {
   "who": "both",
   "text": "Ten!",
   "t": 198.646,
   "dur": 0.503
  },
  {
   "who": "both",
   "text": "Nine!",
   "t": 199.419,
   "dur": 0.54
  },
  {
   "who": "both",
   "text": "Eight!",
   "t": 200.229,
   "dur": 0.508
  },
  {
   "who": "both",
   "text": "Seven!",
   "t": 201.007,
   "dur": 0.613
  },
  {
   "who": "both",
   "text": "Six!",
   "t": 201.89,
   "dur": 0.581
  },
  {
   "who": "both",
   "text": "Five!",
   "t": 202.741,
   "dur": 0.574
  },
  {
   "who": "both",
   "text": "Four!",
   "t": 203.586,
   "dur": 0.535
  },
  {
   "who": "both",
   "text": "Three!",
   "t": 204.391,
   "dur": 0.543
  },
  {
   "who": "both",
   "text": "Two!",
   "t": 205.203,
   "dur": 0.464
  },
  {
   "who": "both",
   "text": "One!",
   "t": 205.938,
   "dur": 0.486
  },
  {
   "who": "both",
   "text": "Merry Christmas!",
   "t": 206.693,
   "dur": 0.934
  },
  {
   "who": "mishu",
   "text": "Wake up! It's Christmas morning! Santa came!",
   "t": 208.877,
   "dur": 2.526
  },
  {
   "who": "gul",
   "text": "It's soft and cuddly!",
   "t": 211.854,
   "dur": 1.303
  },
  {
   "who": "gul",
   "text": "What's inside?",
   "t": 213.407,
   "dur": 0.945
  },
  {
   "who": "mishu",
   "text": "A teddy bear! Thank you, Santa!",
   "t": 216.402,
   "dur": 1.778
  },
  {
   "who": "mishu",
   "text": "It goes choo choo!",
   "t": 218.83,
   "dur": 1.028
  },
  {
   "who": "mishu",
   "text": "What's inside?",
   "t": 220.108,
   "dur": 0.902
  },
  {
   "who": "gul",
   "text": "A toy train!",
   "t": 223.06,
   "dur": 0.94
  },
  {
   "who": "gul",
   "text": "You can colour with them!",
   "t": 224.65,
   "dur": 1.185
  },
  {
   "who": "gul",
   "text": "What's inside?",
   "t": 226.085,
   "dur": 0.945
  },
  {
   "who": "mishu",
   "text": "Crayons!",
   "t": 229.08,
   "dur": 0.708
  },
  {
   "who": "gul",
   "text": "Look! The cookies are gone!",
   "t": 230.439,
   "dur": 1.393
  },
  {
   "who": "mishu",
   "text": "And Santa left a note! Thank you for the cookies! Love, Santa!",
   "t": 232.081,
   "dur": 3.666
  },
  {
   "who": "gul",
   "text": "Santa loves cookies! Let's count, and take away!",
   "t": 236.897,
   "dur": 2.622
  },
  {
   "who": "mishu",
   "text": "Santa had five cookies. He ate two.",
   "t": 239.969,
   "dur": 2.349
  },
  {
   "who": "mishu",
   "text": "Yum, yum! How many are left?",
   "t": 243.168,
   "dur": 1.659
  },
  {
   "who": "gul",
   "text": "Three cookies!",
   "t": 247.077,
   "dur": 0.855
  },
  {
   "who": "gul",
   "text": "Four cookies on the plate. Santa ate one.",
   "t": 248.581,
   "dur": 2.397
  },
  {
   "who": "gul",
   "text": "How many are left?",
   "t": 251.829,
   "dur": 1.004
  },
  {
   "who": "mishu",
   "text": "Three cookies!",
   "t": 255.083,
   "dur": 0.854
  },
  {
   "who": "mishu",
   "text": "Three cookies.",
   "t": 256.587,
   "dur": 0.85
  },
  {
   "who": "mishu",
   "text": "Santa ate all three! How many are left?",
   "t": 258.287,
   "dur": 2.212
  },
  {
   "who": "gul",
   "text": "Zero! None left! Ha ha!",
   "t": 262.749,
   "dur": 1.428
  },
  {
   "who": "mishu",
   "text": "Something is hiding under a present! Can you find it?",
   "t": 265.327,
   "dur": 2.763
  },
  {
   "who": "gul",
   "text": "Which present is it under?",
   "t": 268.54,
   "dur": 1.448
  },
  {
   "who": "mishu",
   "text": "Santa's hat is under the blue present!",
   "t": 272.237,
   "dur": 2.086
  },
  {
   "who": "mishu",
   "text": "Which present is it under?",
   "t": 274.874,
   "dur": 1.366
  },
  {
   "who": "gul",
   "text": "The sleigh bell is under the green present!",
   "t": 278.49,
   "dur": 2.006
  },
  {
   "who": "gul",
   "text": "Which present is it under?",
   "t": 281.046,
   "dur": 1.448
  },
  {
   "who": "mishu",
   "text": "The letter is under the pink present!",
   "t": 284.743,
   "dur": 1.855
  },
  {
   "who": "mishu",
   "text": "Which present is it under?",
   "t": 287.148,
   "dur": 1.366
  },
  {
   "who": "gul",
   "text": "The reindeer's carrot! Found it!",
   "t": 290.764,
   "dur": 1.537
  },
  {
   "who": "gul",
   "text": "Santa yes or no game! Shout yes, or no!",
   "t": 293.351,
   "dur": 2.442
  },
  {
   "who": "mishu",
   "text": "Does Santa have reindeer?",
   "t": 296.243,
   "dur": 1.337
  },
  {
   "who": "gul",
   "text": "Yes! Eight reindeer!",
   "t": 299.431,
   "dur": 1.088
  },
  {
   "who": "gul",
   "text": "Does Santa drive a car?",
   "t": 301.069,
   "dur": 1.488
  },
  {
   "who": "mishu",
   "text": "No! He rides a sleigh!",
   "t": 304.407,
   "dur": 1.273
  },
  {
   "who": "mishu",
   "text": "Does Santa live where it snows?",
   "t": 306.23,
   "dur": 1.605
  },
  {
   "who": "gul",
   "text": "Yes! At the North Pole!",
   "t": 309.686,
   "dur": 1.233
  },
  {
   "who": "gul",
   "text": "Does Santa come in summer?",
   "t": 311.468,
   "dur": 1.465
  },
  {
   "who": "mishu",
   "text": "No! He comes on Christmas Eve!",
   "t": 314.783,
   "dur": 1.775
  },
  {
   "who": "mishu",
   "text": "Does Santa like cookies?",
   "t": 317.108,
   "dur": 1.405
  },
  {
   "who": "gul",
   "text": "Yes! Yummy!",
   "t": 320.363,
   "dur": 0.79
  },
  {
   "who": "gul",
   "text": "Does Santa wear a green suit?",
   "t": 321.703,
   "dur": 1.545
  },
  {
   "who": "mishu",
   "text": "No! He wears red!",
   "t": 325.098,
   "dur": 1.176
  },
  {
   "who": "mishu",
   "text": "Can we write a letter to Santa?",
   "t": 326.825,
   "dur": 1.533
  },
  {
   "who": "gul",
   "text": "Yes! Dear Santa!",
   "t": 330.208,
   "dur": 1.096
  },
  {
   "who": "gul",
   "text": "Do we leave milk for Santa?",
   "t": 331.854,
   "dur": 1.475
  },
  {
   "who": "mishu",
   "text": "Yes! And cookies!",
   "t": 335.179,
   "dur": 1.095
  },
  {
   "who": "gul",
   "text": "Big kids! Look at the pattern. What comes next?",
   "t": 337.323,
   "dur": 2.267
  },
  {
   "who": "mishu",
   "text": "What comes next?",
   "t": 340.041,
   "dur": 1.013
  },
  {
   "who": "gul",
   "text": "A present!",
   "t": 343.303,
   "dur": 0.71
